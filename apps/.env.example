# PulseFeed 本地编排的宿主端口覆盖示例。
# 复制为 apps/.env 后按需修改（.env 已被 .gitignore 忽略，不会提交）。
# 所有变量都可省略：省略时使用下面注释里的默认值，与 docker-compose.yml 的 ${VAR:-默认} 一致。
# 容器内端口与服务名固定不变；修改这里只改宿主映射，不影响容器间通信与内部引用。

# MySQL 宿主端口（容器内固定 3306）
MYSQL_PORT=3307

# Redis 宿主端口（容器内固定 6379）
REDIS_PORT=6380

# RabbitMQ AMQP 宿主端口（容器内固定 5672）
RABBITMQ_PORT=5673

# RabbitMQ 管理台宿主端口（容器内固定 15672）
RABBITMQ_UI_PORT=15673

# API 宿主端口（容器内固定 8090）
API_PORT=8090

# Web（nginx）宿主端口（容器内固定 80）
WEB_PORT=8088

# Worker 指标宿主端口（容器内固定 9092）
WORKER_METRICS_PORT=19092

# Prometheus 宿主端口（容器内固定 9090，仅 monitoring profile）
PROMETHEUS_PORT=19090

# Grafana 宿主端口（容器内固定 3000，仅 monitoring profile）
GRAFANA_PORT=3000

# Windows 注意：Win11 Hyper-V/WinNAT 会动态保留 9020–9119 段，落在该段的宿主端口可能
# 启动失败（bind: 拒绝访问）或无法监听；上面的默认值已避开该段（19090/19092）。
# 若仍冲突，改对应变量即可，无需修改 docker-compose.yml。
# 查看当前保留段：netsh interface ipv4 show excludedportrange protocol=tcp
